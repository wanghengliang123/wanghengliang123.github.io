@article{CHEN2026111899,
title = {A novel functional multi-response bayesian modeling and optimization approach with batch effects and its application in 3D printing},
journal = {Computers & Industrial Engineering},
volume = {214},
pages = {111899},
year = {2026},
issn = {0360-8352},
doi = {https://doi.org/10.1016/j.cie.2026.111899},
url = {https://www.sciencedirect.com/science/article/pii/S0360835226001002},
author = {Xiaoying Chen and Jianjun Wang and Chunfeng Ding and Hengliang Wang},
keywords = {Quality design, Functional multi-response, Batch effects, Bayesian inference, Semiparametric modeling, Reinforcementlearning},
abstract = {Advanced acquisition techniques enable the capture of response curves that vary continuously over time or location, rather than a single scalar response value. The relationship between these responses’ observations and time or location is highly complex. Additionally, additive manufacturing typically employs batch-based production, and the products or processes involve multiple uncertainties. However, prevailing methodologies on functional response quality design often overlooks these critical engineering characteristics. To tackle these challenges, this paper proposes a novel modeling and optimization approach, specifically incorporating a Bayesian semi-parametric two-stage modeling with dual random effects, a multi-objective function based on functional response confidence intervals, and an improved NSGA-II optimization algorithm incorporating reinforcement learning. The novelty of the proposed method lies in utilizing a semi-parametric approach to characterize the complex features of the curve during the modeling stage, while employing a dual-random-effects model to capture batch effects in the functional response. During optimization, functional response confidence intervals are integrated into the multi-objective framework to avoid extreme solutions, while reinforcement learning strategies are incorporated into the NSGA-II algorithm to enhance solution quality. The simulation study and 3D printing case validate the superiority of the proposed modeling and optimization approach.}
}
